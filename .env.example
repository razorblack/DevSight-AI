# Required: Tambo API Key (get from https://tambo.co/dashboard)
TAMBO_API_KEY=your-api-key-here

# Optional: Tambo API base URL (defaults to https://api.tambo.co)
TAMBO_BASE_URL=https://api.tambo.co

# Optional: Maximum request body size in bytes (defaults to 5MB)
TAMBO_MAX_BODY_BYTES=5242880

# Optional: Override where the client sends requests (must be absolute URL)
# Only use this if you're running a custom Tambo server
# NEXT_PUBLIC_TAMBO_URL=https://your-domain.com/api/tambo
